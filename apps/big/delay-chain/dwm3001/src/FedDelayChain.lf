target uC {
  platform: {
    name: Zephyr,
    board: decawave_dwm3001cdk
  },
  net-interface: sicslowpan,
  logging: error,
  clock-sync: on
}

preamble {=
  #include "reactor-uc/reactor-c.h"
=}

// Source and Destination in one reactor/federate such that it can correctly measure the latency
// (otherwise the physical clocks of source and destination might differ)
reactor SourceAndDestination(period: time = 1 sec) {
  output out: instant_t
  input in: instant_t

  timer trigger(1 sec, period)

  reaction scheduleNewDelayChain(trigger) -> out {=
    lf_set(out, lf_time_physical_elapsed());
  =}

  reaction(in) {=
    instant_t now = lf_time_physical_elapsed();
    int64_t latency = now - in->value;

    printf("Latency: %lld.%02lld ms\n", latency / 1000000, latency % 1000000);
  =}
}

reactor Forwarder(bank_index: int = 0) {
  input in: instant_t
  output out: instant_t

  reaction(in) -> out {=
    lf_set(out, in->value);
  =}
}

federated reactor(n: int = 9) {
  @interface_rudp
  @clock_sync(grandmaster=true)
  srcdst = new SourceAndDestination(period = 100 msec)

  @interface_rudp
  fwds = new[n] Forwarder()

  @buffer(20)
  srcdst.out, fwds.out ~> fwds.in, srcdst.in
}
