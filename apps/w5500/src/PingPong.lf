target uC {
    platform: {
        name: Zephyr,
        board: w5500_evb_pico
    },
    net-interface: ethernet,
    logging: warn,
    clock-sync: on
}

preamble {=

  #include "reactor-uc/reactor-c.h"

=}

reactor PingFed {
    input in: int;
    output out: int;

    reaction(startup) -> out {=
        printf("Starting!\n");
        lf_set(out, 0);
    =}

    reaction(in) -> out {=
        lf_set(out, in->value + 1);

        if(in->value % 100 < 10) {
          printf("value: %d\n", in->value + 1);
          interval_t ts = lf_time_logical();
          interval_t Ts = lf_time_physical();

          printf(
              "  logical time: %lld ms, physical time: %lld ms, lag: %lld ms\n",
              ts / 1000000, Ts / 1000000, (Ts-ts) / 1000000
          );
        }
    =}
}

reactor PongFed {
    input in: int;
    output out: int;

    reaction(startup) {=
        printf("Pong federate started.\n");
    =}

    reaction(in) -> out {=
        lf_set(out, in->value + 1);

        if(in->value % 100 < 10) {
          printf("value: %d\n", in->value + 1);
          interval_t ts = lf_time_logical();
          interval_t Ts = lf_time_physical();

          printf(
              "  logical time: %lld ms, physical time: %lld ms, lag: %lld ms\n",
              ts / 1000000, Ts / 1000000, (Ts-ts) / 1000000
          );
        }
    =}
}

federated reactor {
  @interface_tcp(address="192.168.50.10")
  ping = new PingFed();
  @interface_tcp(address="192.168.50.11")
  pong = new PongFed();

  @max_pending_events(10)
  @buffer(10)
  ping.out -> pong.in after 10 msec;
  @max_pending_events(10)
  @buffer(10)
  pong.out -> ping.in after 10 msec;
}
