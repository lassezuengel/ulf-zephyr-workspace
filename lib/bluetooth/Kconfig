# Bluetooth LE Peripheral Library Configuration

config SYNCHROFLY_BT
	bool "Enable SynchroFly Bluetooth LE peripheral"
	depends on BT
	select BT_PERIPHERAL
	select BT_GATT_DYNAMIC_DB
	default n
	help
	  Enable Bluetooth LE peripheral functionality for SynchroFly devices.
	  Provides automatic advertising, connection management, status LED control,
	  and support for MCUmgr DFU when enabled.

if SYNCHROFLY_BT

config SYNCHROFLY_BT_DEVICE_NAME_PREFIX
	string "Device name prefix"
	default "SynchroFly"
	help
	  Prefix for BLE device name. The full name will be
	  "<prefix>-XXXX" where XXXX is the node ID
	  (IoT-LAB compatible UID) in hexadecimal.

config SYNCHROFLY_BT_STATUS_LED
	bool "Enable Bluetooth status LED"
	depends on GPIO
	default y
	help
	  Enable LED indication for Bluetooth status:
	  - OFF: Bluetooth disabled
	  - Blinking (1Hz): Advertising, waiting for connection
	  - ON (solid): Connected

config SYNCHROFLY_BT_NODE_CONFIG_SERVICE
	bool "Enable node configuration GATT service"
	depends on SETTINGS
	default y
	help
	  Enable GATT service for remote configuration of node parameters:
	  - Position (x, y, z coordinates in meters)
	  - Node ID
	  - Node mode (disabled/active/passive)
	  
	  All values persist to settings and survive reboots.

config SYNCHROFLY_BT_NEIGHBOR_TABLE_SERVICE
	bool "Enable neighbor table GATT service"
	depends on NODE_TABLE
	default y if NODE_TABLE
	help
	  Enable GATT service for reading neighbor table information:
	  - Neighbor count
	  - Neighbor list with distance, age, hop count, RSSI
	  
	  Supports notifications to push updates to connected clients.

config SYNCHROFLY_BT_NETWORK_SETTINGS_SERVICE
	bool "Enable network settings GATT service"
	depends on SETTINGS
	default y
	help
	  Enable GATT service for remote configuration of network parameters:
	  - Scheduling scheme (Basic/Hashed/Contention)
	  - Ranging round parameters (slots per phase, phases)
	  - Superframe slots
	  - Glossy parameters (guard, max depth, TX delay)
	  - Scheduler slot duration
	  
	  All values persist to settings and survive reboots.

config SYNCHROFLY_BT_FILTER_CONFIG_CHARS
	bool "Enable distance filter configuration BLE characteristics"
	depends on SYNCHROFLY_BT_NETWORK_SETTINGS_SERVICE
	depends on NODE_TABLE_DISTANCE_SERIES_ENABLED
	default y
	help
	  Add BLE characteristics for runtime configuration of distance
	  filter strategy, window size, poly order, and series capacity.
	  Disabled by default on nRF52832 (DWM1001) to save ~120 bytes RAM.
	  On platforms with more RAM (UWBDeck/nRF52840), enabled by default.

config SYNCHROFLY_BT_UWB_RADIO_SERVICE
	bool "Enable UWB radio settings GATT service"
	default y
	help
	  Enable GATT service for remote configuration of UWB radio parameters:
	  - TX antenna delay
	  - RX antenna delay
	  
	  Antenna delays are in timestamp units (~15.65 ps per unit).

config SYNCHROFLY_BT_SUPERFRAME_CONFIG_SERVICE
	bool "Enable superframe configuration GATT service"
	depends on SETTINGS
	default y
	help
	  Enable GATT service for runtime configuration of superframe structure:
	  - Block count (number of blocks in superframe)
	  - Block configurations (type-specific settings per block)
	  - Apply changes (rebuild and restart superframe)
	  
	  Supports reading/writing individual blocks or full configuration.
	  Changes persist to NVS settings and survive reboots.

config SYNCHROFLY_BT_IDENTIFICATION_SERVICE
	bool "Enable device identification GATT service"
	default y
	help
	  Enable GATT service for triggering visual device identification.
	  Writing to the trigger characteristic causes the status LED to
	  blink rapidly for 2 seconds, helping users identify which physical
	  device corresponds to a BLE address.

config SYNCHROFLY_BT_CRTP_SERVICE
	bool "Enable CRTP bridge GATT service"
	depends on CRAZYFLIE
	default y if CRAZYFLIE
	help
	  Enable GATT service for sending CRTP packets to the Crazyflie.
	  Packets written to the TX characteristic are forwarded via the
	  SPI HCI protocol to the Crazyflie STM32 and injected into its
	  CRTP router. This enables direct control of the Crazyflie via
	  BLE, bypassing the nRF52 radio.
	  
	  Requires CONFIG_CRAZYFLIE to be enabled (Crazyflie connector).
	  
	  Service UUID: 63727470-0000-0000-0000-000000000000 ("crtp")
	  TX Char UUID: 63727470-0000-0000-0000-000000000001

module = CRTP_SERVICE
module-str = CRTP Bridge Service
source "subsys/logging/Kconfig.template.log_config"

config SYNCHROFLY_BT_AB_TESTING_SERVICE
	bool "Enable A/B testing GATT service"
	default y
	help
	  Generic key-value BLE service for runtime A/B testing of firmware
	  algorithm variants.  Write an index to select a toggle, then
	  read/write its uint8 value.  All toggles default to 0 (variant A).

config SYNCHROFLY_BT_SYSTEM_PROFILING_SERVICE
	bool "Enable system profiling GATT service"
	depends on THREAD_STACK_INFO
	depends on SYS_HEAP_RUNTIME_STATS
	default y
	help
	  Enable GATT service exposing runtime system profiling data:
	  - Heap usage (free, allocated, peak bytes)
	  - Per-thread stack usage (name, total size, high watermark)

	  Requires CONFIG_THREAD_STACK_INFO and CONFIG_SYS_HEAP_RUNTIME_STATS.

config SYNCHROFLY_BT_SYSTEM_CONTROL_SERVICE
	bool "Enable system control GATT service"
	default y
	select REBOOT
	help
	  Enable GATT service for remote system control via BLE.
	  Writing to the reset characteristic triggers a soft reboot
	  after a short delay (allowing the BLE write response to be sent).

config SYNCHROFLY_BT_FIRMWARE_STATS_SERVICE
	bool "Enable firmware statistics GATT service"
	depends on FIRMWARE_STATS
	default y if FIRMWARE_STATS
	help
	  BLE service for subscribing to and reading on-demand firmware
	  statistics. Allows a BLE client to activate stat counters,
	  read their values, and receive change-driven notifications.

config SYNCHROFLY_BT_INIT_PRIORITY
	int "Bluetooth initialization priority"
	default 91
	help
	  Priority for Bluetooth initialization. Must be higher than
	  CONFIG_APPLICATION_INIT_PRIORITY (90) to ensure MCUmgr
	  handlers are registered before advertising starts.

endif # SYNCHROFLY_BT
